# Variables de Entorno — Predictor Mundial 2026 v6.0
# Copia este archivo como .env.local para desarrollo local (nunca lo subas a git)

# ─────────────────────────────────────────────────────────────
# REQUERIDA — Gemini API Key (Google AI Studio)
# Obtener en: https://aistudio.google.com/apikey
# IMPORTANTE: Esta key NUNCA se expone al browser.
#             Solo la usa api/analyze.js en el servidor.
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=AQUI TU KEY

# ─────────────────────────────────────────────────────────────
# OPCIONAL — Vercel KV (Redis) para Aprendizaje Compartido
# Sin estas variables, el sistema funciona en modo local
# (cada usuario tiene su propio modelo independiente).
#
# Para habilitar el aprendizaje compartido entre todos los usuarios:
# 1. Ve a tu proyecto en vercel.com
# 2. Storage → Create Database → KV (Redis)
# 3. Conecta el KV al proyecto
# 4. Vercel agrega estas variables automáticamente
# ─────────────────────────────────────────────────────────────
KV_REST_API_URL=https://your-kv-instance.kv.vercel-storage.com
KV_REST_API_TOKEN=your_kv_token_here
KV_REST_API_READ_ONLY_TOKEN=your_kv_readonly_token_here

# ─────────────────────────────────────────────────────────────
# OPCIONAL — Entorno (no modificar en producción)
# ─────────────────────────────────────────────────────────────
NODE_ENV=production
